material {
    name : dartDefaultLit,
    shadingModel : lit,
    doubleSided : true,
    requires : [ color ],
    parameters : [
        {
            type : float4,
            name : baseColor
        },
        {
            type : float,
            name : metallic
        },
        {
            type : float,
            name : roughness
        },
        {
            type : float,
            name : reflectance
        },
        {
            type : float3,
            name : emissiveColor
        }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = materialParams.baseColor * getColor();
        material.metallic = materialParams.metallic;
        material.roughness = materialParams.roughness;
        material.reflectance = materialParams.reflectance;
        // Preserve authored emissive color independently of camera exposure.
        material.emissive = vec4(materialParams.emissiveColor, 0.0);
    }
}
