if(NOT EXISTS "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt")
  message(FATAL_ERROR "Cannot find install manifest: @CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt")
endif()

file(READ "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt" files)
string(APPEND files "\n")
while(NOT files STREQUAL "")
  string(FIND "${files}" "\n" newline)
  string(SUBSTRING "${files}" 0 ${newline} file)
  math(EXPR next_line "${newline} + 1")
  string(SUBSTRING "${files}" ${next_line} -1 files)
  if(file STREQUAL "" OR NOT IS_ABSOLUTE "${file}")
    continue()
  endif()
  set(path "$ENV{DESTDIR}${file}")
  message(STATUS "Uninstalling ${path}")
  if(EXISTS "${path}" OR IS_SYMLINK "${path}")
    file(REMOVE "${path}")
    if(EXISTS "${path}" OR IS_SYMLINK "${path}")
      message(FATAL_ERROR "Problem removing ${path}")
    endif()
  endif()
endwhile()
