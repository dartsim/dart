{
  "schema_version": 2,
  "profile": "dart6",
  "cpp_standard": "C++17",
  "python_binding": "nanobind",
  "optional_python_bindings": [],
  "io_namespace": "dart::utils",
  "gui_backend": "Filament",
  "required_markers": [
    "C++17",
    "nanobind",
    "dart::utils",
    "Filament",
    "Gazebo/gz-physics"
  ],
  "required_paths": [
    ".agents/skills",
    ".claude/commands",
    ".claude/skills/dart-verify-sim/SKILL.md",
    ".codex/agents",
    "dart/utils",
    "docs/onboarding/architecture.md",
    "python/dartpy",
    "scripts/agent_capture.py",
    "dart/gui/Viewer.hpp",
    "dart/gui/DebugOverlay.hpp",
    "python/dartpy/gui/Viewer.cpp",
    "python/dartpy/gui/interactions.cpp",
    "python/tests/unit/gui/test_gui_import.py",
    "python/tests/unit/gui/test_gui_offscreen.py"
  ],
  "forbidden_markers": [
    "C++23 as the release default",
    "dart::io as the release loader namespace"
  ],
  "forbidden_paths": [
    ".codex/skills",
    "dart/io",
    "python/dartpy/nanobind",
    "python/dartpy_nanobind",
    "docs/design/simulation_solver_architecture.md",
    "dart/gui/osg",
    "python/dartpy/gui/osg"
  ],
  "downstream_gates": [
    "pixi run -e gazebo test-gz"
  ]
}
