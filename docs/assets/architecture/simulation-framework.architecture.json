  "cards": [
    {
      "dot": "emerald",
      "title": "Read left to right",
      "items": [
        "Public surface: World, handles, option values, and the installed headers (derivatives, executors, stages)",
        "Selection resolves to an ordered stage schedule; the rigid integration and kinematics stages emit compute graphs, other stages use the executor directly",
        "Selectors are the enum classes of world_options.hpp and multibody_options.hpp; the gate lists every enumerator"
      ]
    },
    {
      "dot": "emerald",
      "title": "Public selectors",
      "items": [
        "RigidBodySolver: SequentialImpulse (default), Ipc, Avbd, Vbd",
        "ContactSolverMethod: SequentialImpulse (default), BoxedLcp",
        "MultibodyIntegrationFamily: SemiImplicit (fuses with the split rigid solve), Variational (standalone stage)",
        "RigidAvbdParameterProfile: Paper2025Table2, SourceDemo2d, SourceDemo3d, MassScaledReference",
        "ContactGradientMode: Analytic, ComplementarityAware, PreContactSurrogate",
        "ComputeAcceleratorPolicy: CpuOnly, PreferAccelerated"
      ]
    },
    {
      "dot": "cyan",
      "title": "Status tags",
      "items": [
        "Implemented: a source path and a scoped test exist",
        "Partial: useful implementation with uncovered contract cells",
        "Planned: accepted work without qualifying implementation"
      ]
    },
    {
      "dot": "orange",
      "title": "Planned defaults",
      "items": [
