    "views": [
      {
        "id": "si-split",
        "label": "Sequential-impulse split pipeline",
        "focus": [
          "sync",
          "rigid_body_velocity",
          "rigid_body_contact",
          "rigid_body_position",
          "kinematics",
          "continuation"
        ],
        "note": "SequentialImpulse, Vbd, or Avbd rigid-only world: separate velocity, contact, position stages; other domains slot in before position."
      },
      {
        "id": "fused-multibody",
        "label": "Fused multibody with unified constraint",
        "focus": [
          "sync",
          "rigid_body_velocity",
          "multibody_velocity",
          "unified_constraint",
          "rigid_body_position",
          "multibody_position",
          "deformable_dynamics",
          "kinematics",
          "continuation"
        ],
        "note": "SemiImplicit multibody shares one constraint solve with rigid bodies, then both positions update; deformables advance before kinematics."
      },
      {
        "id": "combined-ipc",
        "label": "Combined IPC contact and advance",
        "focus": [
          "sync",
          "rigid_ipc_contact",
          "multibody_forward_dynamics",
          "multibody_variational_integration",
          "deformable_dynamics",
          "kinematics",
          "continuation"
        ],
        "note": "Ipc has one contact-and-advance stage; a multibody domain then runs its standalone stage and a deformable domain runs deformable dynamics."
      }
    ],
