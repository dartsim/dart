  "cards": [
    {
      "dot": "emerald",
      "title": "One ordered stage list",
      "items": [
        "makeBuiltInWorldStepSchedule picks at most eight slots from the eleven shown",
        "Empty domains add no stage; deformables advance after the position stages in the fused schedule; kinematics always runs last",
        "Flows name the data a stage hands on, so state ownership is readable"
      ]
    },
    {
      "dot": "cyan",
      "title": "Family variants",
      "items": [
        "Split rigid pipeline: SequentialImpulse, Vbd, Avbd",
        "Combined rigid stage: Ipc only",
        "Multibody: SemiImplicit fuses into the unified constraint; Variational runs standalone"
      ]
    },
    {
      "dot": "orange",
      "title": "Continuation",
      "items": [
        "Replay records substantial continuation state; binary snapshots reject populated AVBD state",
        "StepMetrics and resolved configuration report what actually ran",
        "General state vectors omit free-rigid orientation and deformables today"
      ]
    }
