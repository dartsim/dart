  "cards": [
    {
      "dot": "emerald",
      "title": "Where things live",
      "items": [
        "DART 7 simulation, collision, IO, sensors, math, and common utilities form the library distribution",
        "Collision runs the native detector; fcl, bullet, and ode are compatibility facades with reference engines in tests",
        "dartpy binds the library; dartsim drives the simulation engine through its own editor engine and renders through dart::gui",
        "Handbook pages under docs/onboarding explain each module"
      ]
    },
    {
      "dot": "cyan",
      "title": "DART 7 versus classic",
      "items": [
        "dart::simulation::World is the DART 7 engine; Skeleton-based dynamics stays for DART 6 users",
        "Legacy loading bridges convert Skeleton models into multibody structures",
        "Clean-break policy: release-6.* carries compatibility, main carries DART 7"
      ]
    },
    {
      "dot": "orange",
      "title": "Externals",
      "items": [
        "Eigen, EnTT, Taskflow, fmt, spdlog, assimp, tinyxml2, urdfdom, sdformat, octomap",
        "Filament, ImGui, GLFW for rendering; nanobind for dartpy",
        "CUDA is private and opt-in for selected simulation kernels"
      ]
    }
  ]
