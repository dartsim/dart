ARG BASE_IMAGE=quay.io/pypa/manylinux_2_28_x86_64
FROM $BASE_IMAGE

ARG NUM_CORES=8

# Build every native dependency with the manylinux toolchain: Conda libraries
# require newer GLIBCXX/CXXABI symbols even when their glibc floor is 2.28.
RUN /opt/python/cp313-cp313/bin/pip install "cmake>=3.28,<4.3.4" ninja

RUN yum install -y \
    clang \
    libX11-devel \
    libXcursor-devel \
    libXext-devel \
    libXi-devel \
    libXinerama-devel \
    libXrandr-devel \
    libjpeg-turbo-devel \
    libpng-devel

# fmt
RUN curl -fsSL https://github.com/fmtlib/fmt/archive/refs/tags/11.1.4.tar.gz -o fmt.tar.gz \
    && echo "ac366b7b4c2e9f0dde63a59b3feb5ee59b67974b14ee5dc9ea8ad78aa2c1ee1e  fmt.tar.gz" | sha256sum -c - \
    && mkdir fmt && tar -xf fmt.tar.gz -C fmt --strip-components=1 \
    && mkdir -p fmt/build \
    && cmake fmt -B fmt/build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DFMT_TEST=OFF \
    -DCMAKE_C_FLAGS="-fPIC" \
    -DCMAKE_CXX_FLAGS="-fPIC" \
    && cmake --build fmt/build --target install -j${NUM_CORES} \
    && rm -rf fmt fmt.tar.gz

# assimp
RUN curl -fsSL https://github.com/assimp/assimp/archive/refs/tags/v6.0.5.tar.gz -o assimp.tar.gz \
    && echo "edf3749559c2b7d1f758ffb66fc5bec62186221e623b7f2e8969f17ee46ecb6f  assimp.tar.gz" | sha256sum -c - \
    && mkdir assimp && tar -xf assimp.tar.gz -C assimp --strip-components=1 \
    && mkdir -p assimp/build \
    && cmake assimp -B assimp/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DASSIMP_BUILD_TESTS=OFF -DASSIMP_WARNINGS_AS_ERRORS=OFF \
    && cmake --build assimp/build --target install -j${NUM_CORES} \
    && rm -rf assimp assimp.tar.gz

# eigen
RUN curl -fsSL https://gitlab.com/libeigen/eigen/-/archive/3.4.0/eigen-3.4.0.tar.gz -o eigen.tar.gz \
    && echo "8586084f71f9bde545ee7fa6d00288b264a2b7ac3607b974e54d13e7162c1c72  eigen.tar.gz" | sha256sum -c - \
    && mkdir eigen && tar -xf eigen.tar.gz -C eigen --strip-components=1 \
    && mkdir -p eigen/build \
    && cmake eigen -B eigen/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DEIGEN_BUILD_TESTING=OFF -DEIGEN_BUILD_DOC=OFF \
    && cmake --build eigen/build --target install -j${NUM_CORES} \
    && rm -rf eigen eigen.tar.gz

# octomap
RUN curl -fsSL https://github.com/OctoMap/octomap/archive/refs/tags/v1.10.1.tar.gz -o octomap.tar.gz \
    && echo "b6b6c10c99ab15701dd105840e7d4cf18e226eb68714dd4bdfe049dede5cd489  octomap.tar.gz" | sha256sum -c - \
    && mkdir octomap && tar -xf octomap.tar.gz -C octomap --strip-components=1 \
    && mkdir -p octomap/build \
    && cmake octomap -B octomap/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DBUILD_OCTOVIS_SUBPROJECT=OFF -DBUILD_DYNAMICETD3D_SUBPROJECT=OFF -DBUILD_TESTING=OFF \
    && cmake --build octomap/build --target install -j${NUM_CORES} \
    && rm -rf octomap octomap.tar.gz

# libccd
RUN curl -fsSL https://github.com/danfis/libccd/archive/refs/tags/v2.1.tar.gz -o libccd.tar.gz \
    && echo "542b6c47f522d581fbf39e51df32c7d1256ac0c626e7c2b41f1040d4b9d50d1e  libccd.tar.gz" | sha256sum -c - \
    && mkdir libccd && tar -xf libccd.tar.gz -C libccd --strip-components=1 \
    && mkdir -p libccd/build \
    && cmake libccd -B libccd/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DBUILD_TESTING=OFF -DENABLE_DOUBLE_PRECISION=ON \
    && cmake --build libccd/build --target install -j${NUM_CORES} \
    && rm -rf libccd libccd.tar.gz

# fcl
COPY patches/fcl-0.7.0-gjk-zero-direction.patch /tmp/fcl-0.7.0-gjk-zero-direction.patch
RUN curl -fsSL https://github.com/flexible-collision-library/fcl/archive/refs/tags/0.7.0.tar.gz -o fcl.tar.gz \
    && echo "90409e940b24045987506a6b239424a4222e2daf648c86dd146cbcb692ebdcbc  fcl.tar.gz" | sha256sum -c - \
    && mkdir fcl && tar -xf fcl.tar.gz -C fcl --strip-components=1 \
    && git -C fcl apply /tmp/fcl-0.7.0-gjk-zero-direction.patch \
    && mkdir -p fcl/build \
    && cmake fcl -B fcl/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DBUILD_TESTING=OFF \
    && cmake --build fcl/build --target install -j${NUM_CORES} \
    && rm -rf fcl fcl.tar.gz /tmp/fcl-0.7.0-gjk-zero-direction.patch

# tinyxml2
RUN curl -fsSL https://github.com/leethomason/tinyxml2/archive/refs/tags/11.0.0.tar.gz -o tinyxml2.tar.gz \
    && echo "5556deb5081fb246ee92afae73efd943c889cef0cafea92b0b82422d6a18f289  tinyxml2.tar.gz" | sha256sum -c - \
    && mkdir tinyxml2 && tar -xf tinyxml2.tar.gz -C tinyxml2 --strip-components=1 \
    && mkdir -p tinyxml2/build \
    && cmake tinyxml2 -B tinyxml2/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -Dtinyxml2_BUILD_TESTING=OFF -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
    && cmake --build tinyxml2/build --target install -j${NUM_CORES} \
    && rm -rf tinyxml2 tinyxml2.tar.gz

# console_bridge
RUN curl -fsSL https://github.com/ros/console_bridge/archive/refs/tags/1.0.2.tar.gz -o console_bridge.tar.gz \
    && echo "303a619c01a9e14a3c82eb9762b8a428ef5311a6d46353872ab9a904358be4a4  console_bridge.tar.gz" | sha256sum -c - \
    && mkdir console_bridge && tar -xf console_bridge.tar.gz -C console_bridge --strip-components=1 \
    && mkdir -p console_bridge/build \
    && cmake console_bridge -B console_bridge/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DBUILD_TESTING=OFF \
    && cmake --build console_bridge/build --target install -j${NUM_CORES} \
    && rm -rf console_bridge console_bridge.tar.gz

# urdfdom 6.0.1 uses the .hpp headers introduced in urdfdom_headers 3.0.1;
# keep 3.0.1 even though upstream urdfdom still declares a 3.0.0 floor.
RUN curl -fsSL https://github.com/ros/urdfdom_headers/archive/refs/tags/3.0.1.tar.gz -o urdfdom_headers.tar.gz \
    && echo "42d85a82d1dea2e1252596131e58997244ce6c59d12ae9ab852fe7c35d09f0ec  urdfdom_headers.tar.gz" | sha256sum -c - \
    && mkdir urdfdom_headers && tar -xf urdfdom_headers.tar.gz -C urdfdom_headers --strip-components=1 \
    && mkdir -p urdfdom_headers/build \
    && cmake urdfdom_headers -B urdfdom_headers/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DBUILD_TESTING=OFF \
    && cmake --build urdfdom_headers/build --target install -j${NUM_CORES} \
    && rm -rf urdfdom_headers urdfdom_headers.tar.gz

# urdfdom
RUN curl -fsSL https://github.com/ros/urdfdom/archive/refs/tags/6.0.1.tar.gz -o urdfdom.tar.gz \
    && echo "f34c6b25512fe47a7e4e8806df2b94b166aed13dd19befd6056858be619b6a40  urdfdom.tar.gz" | sha256sum -c - \
    && mkdir urdfdom && tar -xf urdfdom.tar.gz -C urdfdom --strip-components=1 \
    && mkdir -p urdfdom/build \
    && cmake urdfdom -B urdfdom/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DBUILD_TESTING=OFF \
    && cmake --build urdfdom/build --target install -j${NUM_CORES} \
    && rm -rf urdfdom urdfdom.tar.gz

# sdformat embeds its schemas and conversion recipes in the library.
# gz-cmake
RUN curl -fsSL https://github.com/gazebosim/gz-cmake/archive/refs/tags/gz-cmake4_4.2.0.tar.gz -o gz-cmake.tar.gz \
    && echo "62deb00527ea91a5467cfb352189d10303e6508b8d5e52cd6f999bf5a8166cc4  gz-cmake.tar.gz" | sha256sum -c - \
    && mkdir gz-cmake && tar -xf gz-cmake.tar.gz -C gz-cmake --strip-components=1 \
    && cmake gz-cmake -B gz-cmake/build -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
    -DBUILD_SHARED_LIBS=ON -DBUILD_TESTING=OFF \
    && cmake --build gz-cmake/build --target install -j${NUM_CORES} \
    && rm -rf gz-cmake gz-cmake.tar.gz

# gz-utils
RUN curl -fsSL https://github.com/gazebosim/gz-utils/archive/refs/tags/gz-utils3_3.1.1.tar.gz -o gz-utils.tar.gz \
    && echo "e3cf80c00454c964d61948d13e79a790cfa14b82fbb0c76fbd8170105fb28761  gz-utils.tar.gz" | sha256sum -c - \
    && mkdir gz-utils && tar -xf gz-utils.tar.gz -C gz-utils --strip-components=1 \
    && cmake gz-utils -B gz-utils/build -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
    -DBUILD_SHARED_LIBS=ON -DBUILD_TESTING=OFF -DSKIP_log=ON \
    && cmake --build gz-utils/build --target install -j${NUM_CORES} \
    && rm -rf gz-utils gz-utils.tar.gz

# gz-math
RUN curl -fsSL https://github.com/gazebosim/gz-math/archive/refs/tags/gz-math8_8.4.0.tar.gz -o gz-math.tar.gz \
    && echo "36002123cd6383bf70309f744571a1d70c699d2c0af16446d4f81f4e20623736  gz-math.tar.gz" | sha256sum -c - \
    && mkdir gz-math && tar -xf gz-math.tar.gz -C gz-math --strip-components=1 \
    && cmake gz-math -B gz-math/build -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
    -DBUILD_SHARED_LIBS=ON -DBUILD_TESTING=OFF -DSKIP_SWIG=ON -DSKIP_PYBIND11=ON \
    && cmake --build gz-math/build --target install -j${NUM_CORES} \
    && rm -rf gz-math gz-math.tar.gz

# sdformat
RUN curl -fsSL https://github.com/gazebosim/sdformat/archive/refs/tags/sdformat15_15.3.0.tar.gz -o sdformat.tar.gz \
    && echo "b187da7a21a6e0f5e2a45f6b4026a1a69fd39e3f50de26f028313595a1c10cfd  sdformat.tar.gz" | sha256sum -c - \
    && mkdir sdformat && tar -xf sdformat.tar.gz -C sdformat --strip-components=1 \
    && PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:/usr/local/lib64/pkgconfig \
    cmake sdformat -B sdformat/build -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
    -DBUILD_SHARED_LIBS=ON -DBUILD_TESTING=OFF -DSKIP_PYBIND11=ON -DUSE_INTERNAL_URDF=OFF \
    && cmake --build sdformat/build --target install -j${NUM_CORES} \
    && rm -rf sdformat sdformat.tar.gz

# Bullet
RUN curl -fsSL https://github.com/bulletphysics/bullet3/archive/refs/tags/3.25.tar.gz -o bullet3.tar.gz \
    && echo "c45afb6399e3f68036ddb641c6bf6f552bf332d5ab6be62f7e6c54eda05ceb77  bullet3.tar.gz" | sha256sum -c - \
    && mkdir bullet3 && tar -xf bullet3.tar.gz -C bullet3 --strip-components=1 \
    && mkdir -p bullet3/build \
    && cmake bullet3 \
    -B bullet3/build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DBUILD_UNIT_TESTS=OFF \
    -DBUILD_CPU_DEMOS=OFF \
    -DBUILD_BULLET2_DEMOS=OFF \
    -DUSE_DOUBLE_PRECISION=ON -DBULLET2_MULTITHREADING=ON \
    -DCMAKE_C_FLAGS="-fPIC" \
    -DCMAKE_CXX_FLAGS="-fPIC" \
    && cmake --build bullet3/build --target install -j${NUM_CORES} \
    && rm -rf bullet3 bullet3.tar.gz

# GLFW for the Filament GUI; keep only the X11 backend and PIC for dartpy.
RUN curl -fsSL https://github.com/glfw/glfw/archive/refs/tags/3.4.tar.gz -o glfw.tar.gz \
    && echo "c038d34200234d071fae9345bc455e4a8f2f544ab60150765d7704e08f3dac01  glfw.tar.gz" | sha256sum -c - \
    && mkdir glfw && tar -xf glfw.tar.gz -C glfw --strip-components=1 \
    && cmake glfw -B glfw/build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DCMAKE_INSTALL_PREFIX=/usr/local \
    -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
    -DBUILD_SHARED_LIBS=OFF \
    -DGLFW_BUILD_X11=ON -DGLFW_BUILD_WAYLAND=OFF \
    -DGLFW_BUILD_EXAMPLES=OFF -DGLFW_BUILD_TESTS=OFF -DGLFW_BUILD_DOCS=OFF \
    && cmake --build glfw/build --target install -j${NUM_CORES} \
    && rm -rf glfw glfw.tar.gz

# Match DART's source-build ODE settings and retain the ODE collision bindings.
RUN curl -fsSL https://bitbucket.org/odedevs/ode/downloads/ode-0.16.6.tar.gz -o ode.tar.gz \
    && echo "c91a28c6ff2650284784a79c726a380d6afec87ecf7a35c32a6be0c5b74513e8  ode.tar.gz" | sha256sum -c - \
    && tar -xf ode.tar.gz \
    && cmake ode-0.16.6 -B ode-0.16.6/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DBUILD_SHARED_LIBS=ON -DODE_DOUBLE_PRECISION=ON \
    -DODE_WITH_LIBCCD=ON -DODE_WITH_LIBCCD_SYSTEM=ON \
    -DODE_WITH_LIBCCD_BOX_CYL=OFF -DODE_WITH_DEMOS=OFF -DODE_WITH_TESTS=OFF \
    && cmake --build ode-0.16.6/build --target install -j${NUM_CORES} \
    && rm -rf ode-0.16.6 ode.tar.gz

# Use the pinned CMake for wheel builds, including the other Python rows.
ENV PATH=/opt/python/cp313-cp313/bin:$PATH

# AlmaLinux AppStream provides Clang 21; use manylinux's active GCC toolset
# instead of the newer toolset selected by the distribution's Clang configs.
RUN /usr/bin/clang --version \
    && test "$(/usr/bin/clang -dumpversion | cut -d. -f1)" -ge 20 \
    && gcc_install_dir="$(dirname "$(gcc -print-libgcc-file-name)")" \
    && for driver in clang clang++; do \
        sed -i "s@--gcc-install-dir=.*@--gcc-install-dir=${gcc_install_dir}@" \
        "/etc/clang/$(/usr/bin/clang -dumpmachine)-${driver}.cfg"; \
    done \
    && printf '#include <span>\n#include <ranges>\nint main() {}\n' \
    | /usr/bin/clang++ -std=c++20 -stdlib=libstdc++ -x c++ -fsyntax-only -
