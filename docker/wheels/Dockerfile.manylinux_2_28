ARG BASE_IMAGE=quay.io/pypa/manylinux_2_28_x86_64
FROM $BASE_IMAGE

ARG NUM_CORES=8

# Build every native dependency with the manylinux toolchain: Conda libraries
# require newer GLIBCXX/CXXABI symbols even when their glibc floor is 2.28.
RUN /opt/python/cp313-cp313/bin/pip install "cmake>=3.22.1,<4.3.4"

RUN yum install -y \
    boost-devel \
    glew-devel

# fmt
RUN git clone --depth 1 https://github.com/fmtlib/fmt.git -b '11.1.4' \
    && mkdir -p fmt/build \
    && cmake fmt -B fmt/build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DFMT_TEST=OFF \
    -DCMAKE_C_FLAGS="-fPIC" \
    -DCMAKE_CXX_FLAGS="-fPIC" \
    && cmake --build fmt/build --target install -j${NUM_CORES} \
    && rm -rf fmt

# assimp
RUN git clone --depth 1 https://github.com/assimp/assimp.git -b 'v6.0.5' \
    && mkdir -p assimp/build \
    && cmake assimp -B assimp/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DASSIMP_BUILD_TESTS=OFF -DASSIMP_WARNINGS_AS_ERRORS=OFF \
    && cmake --build assimp/build --target install -j${NUM_CORES} \
    && rm -rf assimp

# eigen
RUN git clone --depth 1 https://gitlab.com/libeigen/eigen.git -b '3.4.0' \
    && mkdir -p eigen/build \
    && cmake eigen -B eigen/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DEIGEN_BUILD_TESTING=OFF -DEIGEN_BUILD_DOC=OFF \
    && cmake --build eigen/build --target install -j${NUM_CORES} \
    && rm -rf eigen

# octomap
RUN git clone --depth 1 https://github.com/OctoMap/octomap.git -b 'v1.10.0' \
    && mkdir -p octomap/build \
    && cmake octomap -B octomap/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DBUILD_OCTOVIS_SUBPROJECT=OFF -DBUILD_DYNAMICETD3D_SUBPROJECT=OFF -DBUILD_TESTING=OFF \
    && cmake --build octomap/build --target install -j${NUM_CORES} \
    && rm -rf octomap

# libccd
RUN git clone --depth 1 https://github.com/danfis/libccd.git -b 'v2.1' \
    && mkdir -p libccd/build \
    && cmake libccd -B libccd/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DBUILD_TESTING=OFF -DENABLE_DOUBLE_PRECISION=ON \
    && cmake --build libccd/build --target install -j${NUM_CORES} \
    && rm -rf libccd

# fcl
RUN git clone --depth 1 https://github.com/flexible-collision-library/fcl.git -b '0.7.0' \
    && mkdir -p fcl/build \
    && cmake fcl -B fcl/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DBUILD_TESTING=OFF \
    && cmake --build fcl/build --target install -j${NUM_CORES} \
    && rm -rf fcl

# tinyxml2
RUN git clone --depth 1 https://github.com/leethomason/tinyxml2.git -b '11.0.0' \
    && mkdir -p tinyxml2/build \
    && cmake tinyxml2 -B tinyxml2/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -Dtinyxml2_BUILD_TESTING=OFF -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
    && cmake --build tinyxml2/build --target install -j${NUM_CORES} \
    && rm -rf tinyxml2

# console_bridge
RUN git clone --depth 1 https://github.com/ros/console_bridge.git -b '1.0.2' \
    && mkdir -p console_bridge/build \
    && cmake console_bridge -B console_bridge/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DBUILD_TESTING=OFF \
    && cmake --build console_bridge/build --target install -j${NUM_CORES} \
    && rm -rf console_bridge

# urdfdom_headers
RUN git clone --depth 1 https://github.com/ros/urdfdom_headers.git -b '1.1.1' \
    && mkdir -p urdfdom_headers/build \
    && cmake urdfdom_headers -B urdfdom_headers/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DBUILD_TESTING=OFF \
    && cmake --build urdfdom_headers/build --target install -j${NUM_CORES} \
    && rm -rf urdfdom_headers

# urdfdom
RUN git clone --depth 1 https://github.com/ros/urdfdom.git -b '4.0.1' \
    && mkdir -p urdfdom/build \
    && cmake urdfdom -B urdfdom/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DBUILD_TESTING=OFF \
    && cmake --build urdfdom/build --target install -j${NUM_CORES} \
    && rm -rf urdfdom

# Bullet
RUN git clone --depth 1 https://github.com/bulletphysics/bullet3.git -b '3.25' \
    && mkdir -p bullet3/build \
    && cmake bullet3 \
    -B bullet3/build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DBUILD_UNIT_TESTS=OFF \
    -DBUILD_CPU_DEMOS=OFF \
    -DBUILD_BULLET2_DEMOS=OFF \
    -DUSE_DOUBLE_PRECISION=ON -DBULLET2_MULTITHREADING=ON \
    -DCMAKE_C_FLAGS="-fPIC" \
    -DCMAKE_CXX_FLAGS="-fPIC" \
    && cmake --build bullet3/build --target install -j${NUM_CORES} \
    && rm -rf bullet3

# openscenegraph
RUN git clone --depth 1 https://github.com/openscenegraph/OpenSceneGraph.git -b OpenSceneGraph-3.6.5 \
    && mkdir -p OpenSceneGraph/build \
    && cmake OpenSceneGraph -B OpenSceneGraph/build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DBUILD_OSG_APPLICATIONS=OFF \
    -DBUILD_OSG_DEPRECATED_SERIALIZERS=OFF \
    && cmake --build OpenSceneGraph/build --target install -j${NUM_CORES} \
    && rm -rf OpenSceneGraph

# Match the existing external fmt configuration.
RUN git clone --depth 1 https://github.com/gabime/spdlog.git -b v1.15.3 \
    && cmake spdlog -B spdlog/build -DCMAKE_BUILD_TYPE=Release \
    -DSPDLOG_FMT_EXTERNAL=ON -DSPDLOG_BUILD_TESTS=OFF \
    && cmake --build spdlog/build --target install -j${NUM_CORES} \
    && rm -rf spdlog

RUN git clone --depth 1 https://github.com/pybind/pybind11.git -b v3.0.3 \
    && cmake pybind11 -B pybind11/build -DPYBIND11_TEST=OFF \
    && cmake --install pybind11/build \
    && rm -rf pybind11

# Match DART's source-build ODE settings and retain the ODE collision bindings.
RUN curl -fsSL https://bitbucket.org/odedevs/ode/downloads/ode-0.16.6.tar.gz -o ode.tar.gz \
    && echo "c91a28c6ff2650284784a79c726a380d6afec87ecf7a35c32a6be0c5b74513e8  ode.tar.gz" | sha256sum -c - \
    && tar -xf ode.tar.gz \
    && cmake ode-0.16.6 -B ode-0.16.6/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DBUILD_SHARED_LIBS=ON -DODE_DOUBLE_PRECISION=ON \
    -DODE_WITH_LIBCCD=ON -DODE_WITH_LIBCCD_SYSTEM=ON \
    -DODE_WITH_LIBCCD_BOX_CYL=OFF -DODE_WITH_DEMOS=OFF -DODE_WITH_TESTS=OFF \
    && cmake --build ode-0.16.6/build --target install -j${NUM_CORES} \
    && rm -rf ode-0.16.6 ode.tar.gz

# Use the pinned CMake for wheel builds, including the other Python rows.
ENV PATH=/opt/python/cp313-cp313/bin:$PATH
