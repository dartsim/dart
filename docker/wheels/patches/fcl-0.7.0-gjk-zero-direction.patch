From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DART contributors <dartsim@users.noreply.github.com>
Date: Mon, 19 Oct 2026 12:00:00 +0000
Subject: [PATCH] Fix libccd GJK distance at exact tangency

Applies to FCL 0.7.0.

Fix touching convex pairs in FCL's libccd GJK distance, demonstrated for
ellipsoid, ellipsoid-sphere and box pairs. Two ellipsoids with radii
(0.5, 0.5, 0.5) and (0.25, 0.25, 0.25), at identity poses translated to
(0, 0, 0) and (0.75, 0, 0), touch at (0.5, 0, 0). A GST_LIBCCD distance
query starts with a Minkowski support point at the origin. The next support
query uses a zero direction, divides by zero in supportEllipsoid, and
triggers doSimplex2's "A is not in region 1" assertion. Without assertions,
the query returns -1 and incorrect zero-valued witnesses instead. Equal-face
boxes touching along x can also return -1 and zero witnesses in reversed
input order with unsigned distance. Touching inputs that previously
returned -1 now report zero distance with correct witnesses.

Stop GJK before requesting support in a zero direction. When a later
support point is exactly the origin (including reversed input order),
retain that point's original-shape witnesses in a one-point simplex. Let
distance refinement extract the witnesses and return zero before
normalizing a zero direction. Use exact-zero checks so small positive
separations retain their existing results.

Discrete collision queries are unaffected. FCL 0.7.0's GJKCollide uses
libccd's ccdMPRIntersect for boolean collision and ccdMPRPenetration for
contact and penetration queries. Only distance queries reach the patched
__ccdGJK.

Add distance and witness regressions for tangent ellipsoid, ellipsoid-sphere
and box pairs, both input orders, with and without nearest points, at the
origin and after a common translation, with signed distance both enabled
and disabled. Near-tangency separation and shallow-penetration controls pin
the exact-zero semantics without requiring EPA to resolve the shallow
penetration more precisely than its tolerance.

Upstream-Status: Pending (intended for upstream submission; not yet reported)
---
diff --git a/include/fcl/narrowphase/detail/convexity_based_algorithm/gjk_libccd-inl.h b/include/fcl/narrowphase/detail/convexity_based_algorithm/gjk_libccd-inl.h
index 60fd0ad..17c97af 100644
--- a/include/fcl/narrowphase/detail/convexity_based_algorithm/gjk_libccd-inl.h
+++ b/include/fcl/narrowphase/detail/convexity_based_algorithm/gjk_libccd-inl.h
@@ -1616,11 +1616,25 @@ static int __ccdGJK(const void *obj1, const void *obj2,
   ccdVec3Copy(&dir, &last.v);
   ccdVec3Scale(&dir, -CCD_ONE);

+  // first support point is the origin: touching
+  if (ccdVec3X(&dir) == CCD_ZERO && ccdVec3Y(&dir) == CCD_ZERO
+      && ccdVec3Z(&dir) == CCD_ZERO) {
+    return -1;
+  }
+
   // start iterations
   for (iterations = 0UL; iterations < ccd->max_iterations; ++iterations) {
     // obtain support point
     __ccdSupport(obj1, obj2, &dir, ccd, &last);

+    // Preserve the witnesses when a support point is exactly the origin.
+    if (ccdVec3X(&last.v) == CCD_ZERO && ccdVec3Y(&last.v) == CCD_ZERO
+        && ccdVec3Z(&last.v) == CCD_ZERO) {
+      ccdSimplexSet(simplex, 0, &last);
+      ccdSimplexSetSize(simplex, 1);
+      return -1;
+    }
+
     // check if farthest point in Minkowski difference in direction dir
     // isn't somewhere before origin (the test on negative dot product)
     // - because if it is, objects are not intersecting at all.
@@ -2078,7 +2092,7 @@ static inline ccd_real_t _ccdDist(const void *obj1, const void *obj2,
     }

     // check whether we improved for at least a minimum tolerance
-    if ((last_dist - dist) < ccd->dist_tolerance)
+    if (dist == CCD_ZERO || (last_dist - dist) < ccd->dist_tolerance)
     {
       extractClosestPoints(simplex, p1, p2, &closest_p);
       return dist;
diff --git a/test/test_fcl_distance.cpp b/test/test_fcl_distance.cpp
index 3e6ed90..ea3a5ca 100644
--- a/test/test_fcl_distance.cpp
+++ b/test/test_fcl_distance.cpp
@@ -384,6 +384,84 @@ GTEST_TEST(FCL_DISTANCE, NearestPointFromDegenerateSimplex) {
   NearestPointFromDegenerateSimplex<double>();
 }

+static void TangentDistance(
+    const std::shared_ptr<CollisionGeometry<double>>& geometry1,
+    const std::shared_ptr<CollisionGeometry<double>>& geometry2,
+    const Vector3d& tangent_point = Vector3d(0.5, 0, 0)) {
+  for (const Vector3d& offset : {Vector3d(0, 0, 0), Vector3d(1, 2, 3)}) {
+    for (double gap : {0., 1e-9, -1e-9}) {
+      Transform3d tf1 = Transform3d::Identity();
+      Transform3d tf2 = Transform3d::Identity();
+      tf1.translation() = offset;
+      tf2.translation() = offset + Vector3d(0.75 + gap, 0, 0);
+      CollisionObjectd object1(geometry1, tf1);
+      CollisionObjectd object2(geometry2, tf2);
+      const Vector3d witness1 = offset + tangent_point;
+      const Vector3d witness2 = witness1 + Vector3d(gap, 0, 0);
+
+      for (bool reverse : {false, true}) {
+        for (bool nearest : {false, true}) {
+          for (bool signed_distance : {false, true}) {
+            SCOPED_TRACE(::testing::Message() << "offset: " << offset.transpose()
+                         << ", gap: " << gap << ", reverse: " << reverse
+                         << ", nearest: " << nearest
+                         << ", signed distance: " << signed_distance);
+            DistanceRequestd request;
+            request.gjk_solver_type = GST_LIBCCD;
+            request.enable_nearest_points = nearest;
+            request.enable_signed_distance = signed_distance;
+            DistanceResultd result;
+            const double dist = reverse
+                ? distance(&object2, &object1, request, result)
+                : distance(&object1, &object2, request, result);
+            if (gap < 0) {
+              EXPECT_LT(dist, 0);
+              EXPECT_LT(result.min_distance, 0);
+              if (signed_distance) {
+                EXPECT_GT(dist, -1e-6);
+                EXPECT_GT(result.min_distance, -1e-6);
+              }
+              continue;
+            }
+            if (gap == 0) {
+              EXPECT_EQ(dist, 0);
+              EXPECT_EQ(result.min_distance, 0);
+            } else {
+              EXPECT_NEAR(dist, gap, 1e-12);
+              EXPECT_NEAR(result.min_distance, gap, 1e-12);
+            }
+            if (nearest && gap >= 0) {
+              EXPECT_TRUE(CompareMatrices(result.nearest_points[0],
+                                          reverse ? witness2 : witness1,
+                                          1e-12, MatrixCompareType::absolute));
+              EXPECT_TRUE(CompareMatrices(result.nearest_points[1],
+                                          reverse ? witness1 : witness2,
+                                          1e-12, MatrixCompareType::absolute));
+            }
+          }
+        }
+      }
+    }
+  }
+}
+
+GTEST_TEST(FCL_DISTANCE, TangentEllipsoids) {
+  TangentDistance(std::make_shared<Ellipsoidd>(0.5, 0.5, 0.5),
+                  std::make_shared<Ellipsoidd>(0.25, 0.25, 0.25));
+  TangentDistance(std::make_shared<Ellipsoidd>(0.5, 0.375, 0.25),
+                  std::make_shared<Ellipsoidd>(0.25, 0.125, 0.0625));
+}
+
+GTEST_TEST(FCL_DISTANCE, TangentEllipsoidSphere) {
+  TangentDistance(std::make_shared<Ellipsoidd>(0.5, 0.375, 0.25),
+                  std::make_shared<Sphered>(0.25));
+}
+
+GTEST_TEST(FCL_DISTANCE, TangentBoxes) {
+  TangentDistance(std::make_shared<Boxd>(1, 1, 1),
+                  std::make_shared<Boxd>(0.5, 1, 1), Vector3d(0.5, 0.5, 0.5));
+}
+
 template<typename BV, typename TraversalNode>
 void distance_Test_Oriented(const Transform3<typename BV::S>& tf,
                             const std::vector<Vector3<typename BV::S>>& vertices1, const std::vector<Triangle>& triangles1,
